{% extends "base.njk" %}
{% from "hero/page-hero.njk" import page_hero %}
{% from "projects/project-card.njk" import project_card %}

{% block content %}
{{ page_hero('Проекты', [
  { label: 'Главная', href: '/index.html' },
  { label: 'Проекты' }
], { photo: true }) }}

<section class="section">
  <div class="container">
    <div class="grid grid--3">
      {% for item in projects.items %}
      {{ project_card(item, { layout: 'grid' }) }}
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
