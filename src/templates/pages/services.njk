{% extends "base.njk" %}
{% from "hero/page-hero.njk" import page_hero %}
{% from "ui/section-tag.njk" import section_tag %}

{% set services = [
  { title: 'Проектирование', description: 'Разрабатываем технологические решения для ЗАВ, КЗС, мехтоков и производственных линий с учетом задач предприятия.' },
  { title: 'Строительство под ключ', description: 'Строим и реконструируем объекты послеуборочной обработки зерна — от проекта до запуска.' },
  { title: 'Подбор и поставка оборудования', description: 'Подбираем и поставляем зерноочистительное, транспортное и технологическое оборудование под необходимую производительность.' },
  { title: 'Монтаж и пусконаладка', description: 'Выполняем монтаж, электромонтаж, настройку оборудования и запуск технологических линий на объекте.' },
  { title: 'Сервис и запасные части', description: 'Обеспечиваем техническое обслуживание, ремонт и поставку запасных частей для бесперебойной работы оборудования.' },
  { title: 'Реконструкция и модернизация', description: 'Модернизируем существующие ЗАВ, КЗС и мехтоки, повышая производительность и эффективность технологических линий.' }
] %}

{% block content %}
{{ page_hero('Услуги', [
  { label: 'Главная', href: 'index.html' },
  { label: 'Услуги' }
], { banner: 1 }) }}

<section class="section">
  <div class="container">
    {{ section_tag('Что мы делаем') }}
    <h2 class="services__title">Полный цикл — от подбора до сервиса</h2>
    <p class="text-secondary services__lede">
      DIKAN сопровождает хозяйство на каждом этапе: от расчета экономики и подбора техники до
      монтажа, обучения персонала и сервисного обслуживания на весь срок службы оборудования.
    </p>

    <div class="grid grid--3">
      {% for service in services %}
      <article class="service-card">
        <span class="service-card__index">{{ ('0' if loop.index < 10 else '') ~ loop.index }}</span>
        <h3 class="service-card__title">{{ service.title }}</h3>
        <p class="text-secondary">{{ service.description }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% include "contacts/contact-form.njk" %}
{% endblock %}
