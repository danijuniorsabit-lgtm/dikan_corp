{% extends "base.njk" %}
{% from "hero/page-hero.njk" import page_hero %}
{% from "ui/section-tag.njk" import section_tag %}

{% set team = [
  { name: 'Динара Искакова', role: 'Учредитель компании', photo: '/images/team/iskakova.jpg' },
  { name: 'Кайрат Искаков', role: 'Генеральный директор', photo: '/images/team/team.jpg' },
  { name: 'Марат Искаков', role: 'Технический директор', photo: '/images/team/team.jpg' },
  { name: 'Ерканат Рыспаев', role: 'Исполнительный директор', photo: '/images/team/team.jpg' },
  { name: 'Анатолий Баранов', role: 'Бренд-амбассадор JK Machinery в РК', photo: '/images/team/team.jpg' },
  { name: 'Есмуханов Бахтияр', role: 'Руководитель отдела продаж', photo: '/images/team/esmukhanov.jpg' },
  { name: 'Валлиулин Амир', role: 'Менеджер по продажам', photo: '/images/team/valliulin.jpg' },
  { name: 'Жанат Байленов', role: 'Эксперт продаж', photo: '/images/team/team.jpg' },
  { name: 'Талгат Омаров', role: 'Менеджер отдела продаж', photo: '/images/team/omarov.jpg' },
  { name: 'Зару Алинова', role: 'Специалист call-центра', photo: '/images/team/team.jpg' },
  { name: 'Абильмажинов Темирлан', role: 'Бухгалтер', photo: '/images/team/abilmazhinov.jpg' },
  { name: 'Исмаилова Майра', role: 'Бухгалтер', photo: '/images/team/ismailova.jpg' },
  { name: 'Искакова Айнагуль', role: 'Финансовый директор', photo: '/images/team/team.jpg' }
] %}

{% set certificates = [
  'Эксклюзивный партнёр JK Machinery в Центральной Азии',
  'Сертификат соответствия ГОСТ на монтаж и наладку',
  'Партнёр компании «Агропромтехника»'
] %}

{% block content %}
{{ page_hero('О компании', [
  { label: 'Главная', href: 'index.html' },
  { label: 'О компании' }
], { photo: true }) }}

<section class="section">
  <div class="container about-page__intro">
    {{ section_tag('Миссия') }}
    <h2>Делаем очистку зерна выгодной, а не обязательной статьёй расходов</h2>
    <p class="text-secondary">
      Мы подбираем и обслуживаем технику так, чтобы хозяйство окупало вложения в неё за один
      сезон — а не воспринимало очистку зерна как вынужденные издержки.
    </p>
  </div>
</section>

<section class="section section--surface">
  <div class="container about-page__history">
    {{ section_tag('История') }}
    <h2>С 2005 года — на рынке сельхозтехники Казахстана</h2>
    <p class="text-secondary">
      ТОО «Торговый дом ДИКАН» — казахстанская компания, основанная в 2005 году. Сегодня ДИКАН
      специализируется на проектировании и строительстве объектов послеуборочной обработки зерна,
      создании зерноочистительных и семенных линий, поставке технологического оборудования,
      монтаже, запуске и сервисном обслуживании объектов.
    </p>
    <p class="text-secondary">
      За годы работы компания прошла путь от поставщика сельскохозяйственной техники и запасных
      частей до комплексной инженерной компании, реализующей проекты от разработки технологического
      решения до запуска готового объекта.
    </p>
    <p class="text-secondary">
      ДИКАН является эксклюзивным партнёром JK Machinery и представляет современные европейские
      технологии очистки, сортировки и калибровки зерна и семян на рынке Центральной Азии. Сегодня
      оборудование JK Machinery представлено компанией ДИКАН на территории Казахстана, Узбекистана
      и Кыргызстана.
    </p>
    <p class="text-secondary">
      В 2022 году ДИКАН открыл представительство в Ташкенте. Сегодня ТОО «Торговый дом ДИКАН» —
      это команда из более чем 50 специалистов. За годы работы: 1500+ клиентов, 100+ реализованных
      проектов, 20+ лет на аграрном рынке.
    </p>

    <div class="about-stats">
      <div class="about-stats__item about-stats__item--stat">
        <span class="about-stats__value">2005</span>
        <span class="about-stats__caption">год основания компании</span>
      </div>
      <div class="about-stats__item about-stats__item--photo about-stats__item--stat" data-tone="wheat-grain">
        <span class="about-stats__value">20+</span>
        <span class="about-stats__caption">лет на рынке</span>
      </div>
      <div class="about-stats__item about-stats__item--stat">
        <span class="about-stats__value">94%</span>
        <span class="about-stats__caption">запчастей в наличии на складе</span>
      </div>
      <div class="about-stats__item about-stats__item--photo about-stats__item--stat" data-tone="grain-seeds">
        <span class="about-stats__value">100+</span>
        <span class="about-stats__caption">реализованных проектов</span>
      </div>
      <div class="about-stats__item about-stats__item--stat">
        <span class="about-stats__value">1500+</span>
        <span class="about-stats__caption">клиентов</span>
      </div>
      <div class="about-stats__item about-stats__item--stat">
        <span class="about-stats__value">50+</span>
        <span class="about-stats__caption">специалистов</span>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {{ section_tag('Команда') }}
    <h2 class="about-page__section-title">Люди, которые отвечают за результат</h2>
    <div class="grid grid--4">
      {% for member in team %}
      <article class="team-member">
        <img class="team-member__photo" src="{{ member.photo }}" alt="{{ member.name }}" loading="lazy" />
        <p class="team-member__name">{{ member.name }}</p>
        <p class="team-member__role text-secondary">{{ member.role }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--surface">
  <div class="container">
    {{ section_tag('Сертификаты') }}
    <h2 class="about-page__section-title">Подтверждённая экспертиза</h2>
    <div class="grid grid--3">
      {% for cert in certificates %}
      <article class="certificate-card">
        <span class="certificate-card__icon" aria-hidden="true"></span>
        <p>{{ cert }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% include "contacts/contact-form.njk" %}
{% include "media/media-section.njk" %}
{% endblock %}
