  { name: 'Валлиулин Амир', role: 'Менеджер по продажам', photo: 'https://dikan.kz/upload/iblock/494/u3wm3bucnjptitkdmwv1s8b6ssl55bpu.JPG' },
  { name: 'Жанат Байленов', role: 'Эксперт продаж', photo: 'https://dikan.kz/upload/iblock/1ed/uom8e2zvn8vogv3mztr51wadmqi0xdd5.jpg' },
  { name: 'Талгат Омаров', role: 'Менеджер отдела продаж', photo: 'https://dikan.kz/upload/iblock/636/qp3yi36sxk81x2vmy2rvg9vjaf0xkhf4.JPG' },
  { name: 'Зару Алинова', role: 'Специалист call-центра', photo: 'https://dikan.kz/upload/iblock/9c4/1oxc7ndl4zrm08w8yu5fcyk7e3vxh5pn.jpg' },
