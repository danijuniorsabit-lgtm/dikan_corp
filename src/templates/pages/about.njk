  { name: 'Марат Искаков', role: 'Технический директор', photo: 'https://dikan.kz/upload/iblock/95a/x32vc9jwmd2qzrqixlkfn22o9k0gayec.jpg' },
  { name: 'Ерканат Рыспаев', role: 'Исполнительный директор', photo: 'https://dikan.kz/upload/iblock/1ec/7j2wbu1dlidbfftegbykr6hp81dy9vo1.jpg' },
