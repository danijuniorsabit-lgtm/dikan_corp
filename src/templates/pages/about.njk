{% set certificates = [
  'Официальный дилер завода «ARTAYUS» в Казахстане',
  'Сертификат соответствия ГОСТ на монтаж и наладку',
  'Член Ассоциации машиностроителей Казахстана'
] %}

{% block content %}
{{ page_hero('О компании', [
  { label: 'Главная', href: 'index.html' },
  { label: 'О компании' }
], { photo: true }) }}

<section class="section">
  <div class="container about-page__intro">
    {{ section_tag('Миссия') }}
    <h2>Делаем очистку зерна выгодной, а не обязательной статьёй расходов</h2>
    <p class="text-secondary">
      Мы подбираем и обслуживаем технику так, чтобы хозяйство окупало вложения в неё за один
      сезон — а не воспринимало очистку зерна как вынужденные издержки.
    </p>
  </div>
</section>

<section class="section section--surface">
  <div class="container about-page__history">
    {{ section_tag('История') }}
    <h2>С 2005 года — на рынке сельхозтехники Казахстана</h2>
    <p class="text-secondary">
      Компания «DIKAN» была основана в 2005 году и на сегодняшний день представляет собой
      компанию с широкой товарной линейкой сельскохозяйственной техники различного назначения.
      «DIKAN» является эксклюзивным дилером завода по производству техники для обработки почвы
      «ARTAYUS» в Республике Казахстан.
    </p>
    <p class="text-secondary">
      За два десятилетия мы прошли путь от поставок отдельных единиц техники до собственной
      сервисной сети, склада запчастей и инженерной службы, способной реализовать линию по
      очистке зерна под ключ — от расчёта экономики до пусконаладки.
    </p>

    <div class="about-stats">
      <div class="about-stats__item about-stats__item--stat">
        <span class="about-stats__value">2005</span>
        <span class="about-stats__caption">год основания компании</span>
      </div>
      <div class="about-stats__item about-stats__item--photo" data-tone="wheat-grain">
        <span class="about-stats__caption">Экономия зерна при уборке</span>
      </div>
      <div class="about-stats__item about-stats__item--stat">
        <span class="about-stats__value">94%</span>
        <span class="about-stats__caption">запчастей в наличии на складе</span>
      </div>
      <div class="about-stats__item about-stats__item--photo" data-tone="grain-seeds">
        <span class="about-stats__caption">Собственная сервисная служба</span>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {{ section_tag('Команда') }}
    <h2 class="about-page__section-title">Люди, которые отвечают за результат</h2>
    <div class="grid grid--4">
      {% for member in team %}
      <article class="team-member">
        <img class="team-member__photo" src="{{ member.photo }}" alt="{{ member.name }}" loading="lazy" />
        <p class="team-member__name">{{ member.name }}</p>
        <p class="team-member__role text-secondary">{{ member.role }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--surface">
  <div class="container">
    {{ section_tag('Сертификаты') }}
    <h2 class="about-page__section-title">Подтверждённая экспертиза</h2>
    <div class="grid grid--3">
      {% for cert in certificates %}
      <article class="certificate-card">
        <span class="certificate-card__icon" aria-hidden="true"></span>
        <p>{{ cert }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% include "contacts/contact-form.njk" %}
{% include "media/media-section.njk" %}
{% endblock %}
