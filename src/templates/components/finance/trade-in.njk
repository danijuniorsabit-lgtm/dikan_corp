{% from "ui/section-tag.njk" import section_tag %}

<section class="section trade-in" id="trade-in">
  <div class="container trade-in__inner">
    {{ section_tag('Трейд-ин') }}
    <h2>Трейд-ин</h2>
    <p class="text-secondary">Финансовое решение для вашего хозяйства</p>

    <ol class="trade-in-steps">
      <li class="trade-in-steps__item">
        <span class="trade-in-steps__circle">1</span>
        <span class="trade-in-steps__label">Оцениваем вашу технику</span>
      </li>
      <li class="trade-in-steps__arrow" aria-hidden="true">→</li>
      <li class="trade-in-steps__item">
        <span class="trade-in-steps__circle">2</span>
        <span class="trade-in-steps__label">Засчитываем стоимость в счёт новой</span>
      </li>
      <li class="trade-in-steps__arrow" aria-hidden="true">→</li>
      <li class="trade-in-steps__item">
        <span class="trade-in-steps__circle">3</span>
        <span class="trade-in-steps__label">Оформляем новую технику DIKAN</span>
      </li>
    </ol>
  </div>
</section>
