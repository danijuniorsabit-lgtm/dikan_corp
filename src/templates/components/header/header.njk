{% from "ui/icons.njk" import phone, search, menu, close %}

{% set currentHref = '/' ~ page ~ '.html' %}

<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__logo" href="index.html" aria-label="DIKAN — на главную">
      <img class="header__logo-img" src="/images/logo.jpg" alt="DIKAN" />
    </a>

    <div class="header__nav-backdrop" data-nav-backdrop></div>

    <nav class="header__nav" id="primary-navigation" data-header-nav aria-label="Основная навигация">
      <button type="button" class="header__nav-close" data-nav-close aria-label="Закрыть меню">
        <span class="header__icon" aria-hidden="true">{{ close() }}</span>
      </button>

      <ul class="header__nav-list">
        {% for item in nav.items %}
        <li class="header__nav-item">
          <a
            class="header__nav-link{% if item.href == currentHref %} is-active{% endif %}"
            href="{{ item.href }}"
            {%- if item.href == currentHref %} aria-current="page"{% endif %}
          >{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>

      <div class="header__nav-lang" data-lang-switch>
        <button type="button" class="header__nav-lang-btn is-active" data-lang-option="ru" aria-pressed="true">
          RU
        </button>
        <button type="button" class="header__nav-lang-btn" data-lang-option="kz" aria-pressed="false">KZ</button>
      </div>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href="tel:{{ nav.phone | replace(' ', '') }}">
        <span class="header__icon" aria-hidden="true">{{ phone() }}</span>
        <span class="header__phone-number">{{ nav.phone }}</span>
      </a>

      <button
        class="header__icon-btn"
        type="button"
        data-search-toggle
        aria-expanded="false"
        aria-controls="search-overlay"
      >
        <span class="visually-hidden">Поиск по сайту</span>
        <span class="header__icon" aria-hidden="true">{{ search() }}</span>
      </button>

      <button class="header__lang" type="button" aria-label="Язык сайта: русский">RU</button>

      <button
        class="header__burger"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="primary-navigation"
      >
        <span class="visually-hidden">Открыть меню</span>
        <span class="header__icon" data-icon-open aria-hidden="true">{{ menu() }}</span>
        <span class="header__icon" data-icon-close hidden aria-hidden="true">{{ close() }}</span>
      </button>
    </div>

  </div>
</header>

<div class="search-overlay" id="search-overlay" data-search-overlay hidden>
  <div class="search-overlay__backdrop" data-search-backdrop></div>
  <div class="search-overlay__panel" role="dialog" aria-modal="true" aria-label="Поиск по каталогу">
    <div class="search-overlay__field">
      <span class="search-overlay__icon" aria-hidden="true">{{ search() }}</span>
      <label class="visually-hidden" for="header-search-input">Поиск по каталогу</label>
      <input
        id="header-search-input"
        class="search-overlay__input"
        type="search"
        placeholder="Поиск по каталогу..."
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-controls="search-results"
        data-search-input
      />
      <button type="button" class="search-overlay__close" data-search-close>
        <span class="visually-hidden">Закрыть поиск</span>
        <span class="header__icon" aria-hidden="true">{{ close() }}</span>
      </button>
    </div>
    <ul class="search-results" id="search-results" role="listbox" aria-label="Результаты поиска" data-search-results></ul>
  </div>
</div>
