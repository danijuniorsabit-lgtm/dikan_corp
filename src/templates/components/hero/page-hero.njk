{% from "ui/breadcrumbs.njk" import breadcrumbs %}

{# page_hero(title, crumbs, opts) — the short banner hero used on interior pages.
   opts.banner: 1 | 2 | 3 -> swaps the flat gradient for that DIKAN banner photo
   (see _page-hero.scss for the banner-number -> file mapping). #}
{% macro page_hero(title, crumbs, opts={}) %}
<section class="page-hero{% if opts.banner %} page-hero--banner-{{ opts.banner }}{% endif %}">
  <div class="container">
    {{ breadcrumbs(crumbs, { dark: true }) }}
    <h1 class="page-hero__title">{{ title }}</h1>
  </div>
</section>
{% endmacro %}
