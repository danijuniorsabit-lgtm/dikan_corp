{% from "ui/breadcrumbs.njk" import breadcrumbs %}

{# page_hero(title, crumbs) — the short photo-band hero used on interior pages (products, product-detail). #}
{% macro page_hero(title, crumbs) %}
<section class="page-hero">
  <div class="container">
    {{ breadcrumbs(crumbs, { dark: true }) }}
    <h1 class="page-hero__title">{{ title }}</h1>
  </div>
</section>
{% endmacro %}
