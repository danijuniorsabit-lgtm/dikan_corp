{% from "ui/section-tag.njk" import section_tag %}

{# expertise_icon(name) — small line icons for the expertise pills. #}
{% macro expertise_icon(name) %}
<svg class="expertise__pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% if name == 'commerce' %}
  <rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/>
  {% elif name == 'design' %}
  <path d="M4 20l1-4L16.5 4.5a2 2 0 0 1 3 3L8 19l-4 1zM14 7l3 3"/>
  {% elif name == 'engineering' %}
  <circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>
  {% elif name == 'construction' %}
  <path d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6"/>
  {% elif name == 'service' %}
  <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6z"/>
  {% endif %}
</svg>
{% endmacro %}

{# Data: data/expertise.json. Behaviour (line drawing, node highlight): assets/js/components/expertise.js #}
<section class="section expertise" data-expertise>
  <div class="container">
    <div class="expertise__top">
      <div class="expertise__intro">
        {{ section_tag('Экспертиза') }}
        <h2 class="expertise__title">{{ expertise.heading }}</h2>
        <p class="expertise__lede">{{ expertise.intro }}</p>
      </div>
      <ul class="expertise__pills">
        {% for pill in expertise.pills %}
        <li class="expertise__pill">{{ expertise_icon(pill.icon) }}<span>{{ pill.label }}</span></li>
        {% endfor %}
      </ul>
    </div>

    <p class="expertise__lead-in">{{ expertise.leadIn }}</p>

    <div class="expertise-route" data-expertise-route>
      <svg class="expertise-route__svg" data-route-svg aria-hidden="true" focusable="false">
        <path class="expertise-route__track" data-route-track />
        <path class="expertise-route__progress" data-route-progress />
      </svg>
      <ol class="expertise-route__list">
        {% for step in expertise.steps %}
        {% set phase_start = loop.first or step.phase != expertise.steps[loop.index0 - 1].phase %}
        {% set row_start = (not phase_start) and (loop.index0 % 5 == 0) %}
        <li class="expertise-step" data-route-step>
          {% if phase_start %}
          <span class="expertise-step__phase">{{ expertise.phases[step.phase] }}</span>
          {% elif row_start %}
          <span class="expertise-step__phase expertise-step__phase--row">{{ expertise.phases[step.phase] }}</span>
          {% else %}
          <span class="expertise-step__phase expertise-step__phase--empty" aria-hidden="true">&nbsp;</span>
          {% endif %}
          <span class="expertise-step__node" data-route-node>{{ loop.index }}</span>
          <span class="expertise-step__label">{{ step.title }}</span>
        </li>
        {% endfor %}
      </ol>
    </div>

    <div class="expertise-banner">
      <p class="expertise-banner__big" aria-hidden="true">
        <span>от идеи</span>
        <svg class="expertise-banner__arrow" viewBox="0 0 200 40" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 20h184M168 6l20 14-20 14" vector-effect="non-scaling-stroke"/>
        </svg>
        <span>до запуска</span>
      </p>
      <p class="expertise-banner__text">{{ expertise.closing }}</p>
    </div>
  </div>
</section>
