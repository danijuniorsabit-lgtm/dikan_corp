{% from "ui/button.njk" import button %}
{% from "ui/section-tag.njk" import section_tag %}

<section class="section about-section" id="about">
  <div class="container">
    <div class="about-section__intro">
      {{ section_tag('О нас') }}
      <p class="about-section__lead">
        ТОО «Торговый дом ДИКАН» — казахстанская компания, основанная в 2005 году.
        Специализируемся на проектировании и строительстве объектов послеуборочной обработки
        зерна, поставке технологического оборудования JK Machinery, монтаже, запуске и сервисном
        обслуживании объектов.
      </p>
      {{ button('Узнать больше', { href: 'about.html', variant: 'outline', icon: false }) }}
    </div>

    <div class="about-stats">
      <div class="about-stats__item about-stats__item--photo about-stats__item--stat" data-tone="wheat-grain">
        <span class="about-stats__value">20+</span>
        <span class="about-stats__caption">лет на рынке</span>
      </div>
      <div class="about-stats__item about-stats__item--photo about-stats__item--stat" data-tone="hands-grain">
        <span class="about-stats__value">100+</span>
        <span class="about-stats__caption">реализованных проектов</span>
      </div>
      <div class="about-stats__item about-stats__item--photo about-stats__item--stat" data-tone="grain-seeds">
        <span class="about-stats__value">1500+</span>
        <span class="about-stats__caption">клиентов</span>
      </div>
      <div class="about-stats__item about-stats__item--photo about-stats__item--stat" data-tone="wheat-field">
        <span class="about-stats__value">50+</span>
        <span class="about-stats__caption">специалистов</span>
      </div>
    </div>
  </div>
</section>
